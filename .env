# ==================================
# CONFIGURACIÓN - Base de Datos
# ==================================
DB_NAME=despachos_db
DB_USERNAME=root
DB_PASSWORD=S3gura!P4ssw0rd2026

# ==================================
# CONFIGURACIÓN - AWS
# ==================================
AWS_REGION=us-east-1

# ==================================
# CONFIGURACIÓN - Puertos
# ==================================
MYSQL_PORT=3306
BACKEND_VENTAS_PORT=8080
BACKEND_DESPACHOS_PORT=8081
FRONTEND_PORT=3000

# ==================================
# CONFIGURACIÓN - Imágenes
# ==================================
MYSQL_IMAGE=mysql:8.0.35
BACKEND_VENTAS_IMAGE=ventas-backend:1.0
BACKEND_DESPACHOS_IMAGE=despachos-backend:1.0
FRONTEND_IMAGE=despacho-frontend:1.0

# ==================================
# CONFIGURACIÓN - Logging
# ==================================
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ==================================
# CONFIGURACIÓN - Ambiente
# ==================================
ENVIRONMENT=development
LOG_LEVEL=INFO